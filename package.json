{
  "name": "my-store",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "build": "npm run validate:env && next build",
    "build:unsafe": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "jest --config=jest.config.ts",
    "test:watch": "jest --watch --config=jest.config.ts",
    "test:unit": "jest --config=jest.config.ts",
    "test:integration": "jest --config=jest.integration.config.ts",
    "test:integration:mock": "jest --config=jest.integration.config.ts",
    "test:contract": "node scripts/require-stripe-keys.js && jest --config=jest.contract.config.ts",
    "test:api-integration": "node scripts/require-stripe-keys.js && jest --config=jest.api-integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:contract && npm run test:api-integration",
    "test:ci": "npm run test:unit && npm run test:integration",
    "test:ci:full": "npm run test:unit && npm run test:integration && npm run test:contract && npm run test:api-integration && npm run test:e2e",
    "validate:env": "node scripts/validate-env.js",
    "validate:env:strict": "node scripts/validate-env.js --strict",
    "validate:stripe": "node scripts/require-stripe-keys.js",
    "validate:stripe:strict": "node scripts/require-stripe-keys.js --strict",
    "validate:stripe-domains": "node scripts/validate-stripe-domains.js",
    "generate:env": "node scripts/generate-env-example.js",
    "check:console-unicode": "node scripts/check-console-unicode.js",
    "setup:hooks": "node scripts/setup-git-hooks.js"
  },
  "dependencies": {
    "@stripe/react-stripe-js": "^3.9.0",
    "@stripe/stripe-js": "^7.8.0",
    "lucide-react": "^0.525.0",
    "next": "^15.3.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "stripe": "^18.4.0",
    "zod": "^4.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.30.1",
    "@next/eslint-plugin-next": "^15.3.5",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.10",
    "@types/react": "^19.1.8",
    "dotenv": "^16.3.1",
    "eslint": "^9.30.1",
    "eslint-config-next": "^15.3.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "jest": "^30.0.4",
    "jest-environment-jsdom": "^30.0.4",
    "node-fetch": "^2.7.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.35.1"
  }
}
